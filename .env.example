# =============================================================================
# Ghost Queue — Environment Variables Template
# =============================================================================
# Instructions:
# 1. Copy this file to .env (or .env.local):
#      cp .env.example .env
# 2. Replace the placeholder values with your Firebase project configuration.
# 3. Obtain credentials from Firebase Console:
#      Project Settings -> General -> Your apps -> Web apps -> Config
# =============================================================================

# Firebase Web App Configuration (Required)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# Firebase Cloud Messaging (Web Push VAPID Key - Optional)
# Generate from: Firebase Console -> Project Settings -> Cloud Messaging -> Web configuration
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# Firebase App Check via reCAPTCHA v3 (Optional for production DDoS defense)
# Register site at: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here
